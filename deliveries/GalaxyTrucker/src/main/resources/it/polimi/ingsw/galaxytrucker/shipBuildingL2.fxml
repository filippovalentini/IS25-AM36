    <ImageView fitHeight="600.0" fitWidth="854.0" preserveRatio="true" AnchorPane.leftAnchor="191.0" AnchorPane.rightAnchor="191.0" AnchorPane.topAnchor="70.0">
        <Image url="@images/cardboard/shipL2.jpg" />
    </ImageView>

    <Pane fx:id="notificationPane" layoutX="20.0" layoutY="10.0" prefHeight="30.0" prefWidth="500.0" opacity="0.0">
        <children>
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#b2ffb2" height="30.0" stroke="BLACK" strokeType="INSIDE" width="500.0" />
            <Label fx:id="notificationLabel" layoutX="10.0" layoutY="5.0" prefHeight="20.0" prefWidth="480.0"
                   text="" style="-fx-font-size: 14px; -fx-text-fill: green;" />
        </children>
    </Pane>

    <!-- Rettangolo per messaggi di errore (rosso) -->
