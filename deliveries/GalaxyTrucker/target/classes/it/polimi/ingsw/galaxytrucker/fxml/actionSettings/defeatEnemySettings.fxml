<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="234.0" prefWidth="484.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-border-color: #003366; -fx-border-width: 5px;"
            fx:controller="it.polimi.ingsw.galaxytrucker.ui.gui.actionSettingsControllers.DefeatEnemyController">

    <VBox alignment="CENTER" spacing="15.0"
          style="-fx-background-color: #87CEFA;"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <Label text="Select number of batteries to use to improve your cannon strength" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #003366;" />
        <ComboBox fx:id="batteryComboBox" prefWidth="150.0" />

        <Label text="Lose flight days" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #003366;" />
        <ComboBox fx:id="flightDaysComboBox" prefWidth="150.0" />

        <Button fx:id="confirmButton" prefWidth="100.0" text="Confirm" style="-fx-text-fill: #003366;" />

    </VBox>
</AnchorPane>